{
  "name": "shubhamc4/zf1",
  "description": "Zend Framework 1 updated for PHP 8.2 compatibility",
  "type": "library",
  "authors": [
    {
      "name": "Shubham Chaudhary",
      "homepage": "https://github.com/Shubhamc4"
    }
  ],
  "keywords": [
    "framework",
    "zf1",
    "php8.2",
    "compatibility"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "vlucas/phpdotenv": "^5.6.2"
  },
  "require-dev": {
    "laravel/pint": "^1.32.1"
  },
  "autoload": {
    "psr-0": {
      "Zend_": "library/",
      "ZF1_": "library/"
    },
    "psr-4": {
      "ZF1\\": "library/ZF1/"
    },
    "files": [
      "library/ZF1/Support/helpers.php"
    ]
  },
  "bin": ["bin/zf"],
  "minimum-stability": "stable"
}
