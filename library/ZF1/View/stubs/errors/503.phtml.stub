            justify-content: center;
            gap: 0.35rem;
        }
        .clock-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .live-timer {
            font-family: 'Inter', ui-monospace, monospace;
            font-size: 2.25rem;
            font-weight: 700;
            color: var(--brand-primary);
            letter-spacing: 0.02em;
            font-variant-numeric: tabular-nums;
        }
        .actions {
            display: flex;
            gap: 0.75rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        .btn {
            font-family: inherit;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            font-size: 0.875rem;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.15s ease-in-out;
            text-decoration: none;
            border: 1px solid transparent;
        }
        .btn-primary {
            background-color: var(--brand-primary);
            color: #ffffff;
        }
        .btn-primary:hover {
            background-color: var(--brand-hover);
        }
        .btn-outline {
            background-color: transparent;
            border-color: var(--border-color);
            color: var(--text-body);
        }
        .btn-outline:hover {
            background-color: var(--badge-bg);
            border-color: var(--badge-border);
        }
        .btn-sm {
            padding: 0.45rem 0.85rem;
            font-size: 0.8125rem;
        }
        .bypass-section {
            border-top: 1px solid var(--border-color);
            margin-top: 1.5rem;
            padding-top: 1.25rem;
        }
        .bypass-toggle-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 0.8125rem;
            cursor: pointer;
            text-decoration: underline;
            transition: color 0.15s;
            font-family: inherit;
        }
        .bypass-toggle-btn:hover {
            color: var(--brand-primary);
        }
        .bypass-form {
            display: none;
            margin-top: 1rem;
            text-align: left;
        }
        .bypass-form.show {
            display: block;
        }
        .input-group {
            display: flex;
            gap: 0.5rem;
        }
        .form-control {
            font-family: inherit;
            flex: 1;
            padding: 0.55rem 0.85rem;
            font-size: 0.875rem;
            background: var(--bg-page);
            color: var(--text-heading);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            outline: none;
            transition: border-color 0.15s;
        }
        .form-control:focus {
            border-color: var(--brand-primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }
        .footer-note {
            margin-top: 2rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border-color);
            font-size: 0.75rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="brand-header">
            <img class="brand-logo" src="/logo.png" alt="Logo" onerror="this.style.display='none'; document.getElementById('brand-fallback').style.display='block';">
            <div id="brand-fallback" class="brand-fallback" style="display: none;">
                <?= htmlspecialchars($appName, ENT_QUOTES, 'UTF-8') ?>
            </div>
        </div>

        <div class="status-pill">
            <div class="pulse-dot"></div>
            <span><?= $isDown ? 'Scheduled Maintenance' : 'Service Unavailable' ?></span>
        </div>

        <div class="status-code-large">
            503
        </div>

        <h1><?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?></h1>

        <p class="message">
            <?= htmlspecialchars($message, ENT_QUOTES, 'UTF-8') ?>
        </p>

        <?php if (! empty($errorMessage)) { ?>
            <div class="alert-danger">
                <?= htmlspecialchars($errorMessage, ENT_QUOTES, 'UTF-8') ?>
            </div>
        <?php } ?>

        <div class="clock-container">
            <span class="clock-label" id="clock-status">Auto-refreshing in</span>
            <div class="live-timer" id="countdown-timer">--:--</div>
        </div>

        <div class="actions">
            <button type="button" class="btn btn-primary" onclick="triggerManualReload()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
                Refresh Now
            </button>
            <a href="<?= htmlspecialchars($homeUrl, ENT_QUOTES, 'UTF-8') ?>" class="btn btn-outline">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                Homepage
            </a>
        </div>

        <?php if ($hasSecret) { ?>
            <div class="bypass-section">
                <button type="button" class="bypass-toggle-btn" onclick="toggleBypassForm()">
                    Authorized Personnel? Enter Bypass Key
                </button>
                <form method="POST" class="bypass-form <?= ! empty($errorMessage) ? 'show' : '' ?>" id="bypass-form" autocomplete="off">
                    <input type="hidden" name="redirect" value="<?= $currentUri ?>">
                    <div class="input-group">
                        <input type="password" name="maintenance_secret" class="form-control" placeholder="Enter bypass key" required autofocus>
                        <button type="submit" class="btn btn-primary btn-sm">Unlock</button>
                    </div>
                </form>
            </div>
        <?php } ?>

        <div class="footer-note">
            <?= htmlspecialchars($appName, ENT_QUOTES, 'UTF-8') ?> &bull; &copy; <?= date('Y') ?>
        </div>
    </div>

    <script>
        (function() {
            var remaining = <?= $retryAfter ?>;
            var timerEl = document.getElementById('countdown-timer');
            var statusEl = document.getElementById('clock-status');

            function formatTime(t) {
                var m = Math.floor(t / 60);
                var s = t % 60;
                return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
            }

            function updateDisplay() {
                if (timerEl) {
                    timerEl.textContent = formatTime(remaining);
                }
            }

            updateDisplay();

            var timerInterval = setInterval(function() {
                remaining--;
                if (remaining <= 0) {
                    clearInterval(timerInterval);
                    if (timerEl) timerEl.textContent = '00:00';
                    if (statusEl) statusEl.textContent = 'Checking server status...';
                    window.location.reload();
                } else {
                    updateDisplay();
                }
            }, 1000);

            window.triggerManualReload = function() {
                if (statusEl) statusEl.textContent = 'Checking server status...';
                window.location.reload();
            };

            window.toggleBypassForm = function() {
                var form = document.getElementById('bypass-form');
                if (form) {
                    form.classList.toggle('show');
                    if (form.classList.contains('show')) {
                        var input = form.querySelector('input[name="maintenance_secret"]');
                        if (input) input.focus();
                    }
                }
            };
        })();
    </script>
</body>
</html>
