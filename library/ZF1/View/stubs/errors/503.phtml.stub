<?php

$code = 503;
$isDown = class_exists(\ZF1\System\MaintenanceMode::class) && \ZF1\System\MaintenanceMode::isDown();
$downData = $isDown ? (\ZF1\System\MaintenanceMode::getData() ?: []) : [];

if ($isDown && ! empty($downData['message']) && (empty($message) || $message === 'The server is temporarily unavailable or undergoing scheduled maintenance. Please check back shortly.')) {
    $message = (string) $downData['message'];
}

$title = $title ?? ($isDown ? 'Maintenance in Progress' : 'Service Unavailable');
$message = $message ?? 'The server is temporarily unavailable or undergoing scheduled maintenance. Please check back shortly.';
$appName = $appName ?? (function_exists('app_name') ? app_name() : (defined('APP_NAME') ? (string) APP_NAME : 'ZF1'));
$homeUrl = $homeUrl ?? (function_exists('app_url') ? app_url('/') : '/');
$currentUri = htmlspecialchars($_SERVER['REQUEST_URI'] ?? '/', ENT_QUOTES, 'UTF-8');
$theme = $theme ?? (class_exists(\ZF1\View\ErrorRenderer::class) ? \ZF1\View\ErrorRenderer::theme() : 'auto');

$retryAfter = (int) ($retryAfter ?? ($downData['retry'] ?? 60));
$secret = $secret ?? (! empty($downData['secret']) ? (string) $downData['secret'] : null);
$hasSecret = ! empty($secret);
$errorMessage = $errorMessage ?? null;
?>
<!DOCTYPE html>
<html lang="en" data-theme="<?= htmlspecialchars($theme, ENT_QUOTES, 'UTF-8') ?>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><?= htmlspecialchars($title, ENT_QUOTES, 'UTF-8') ?> | <?= htmlspecialchars($appName, ENT_QUOTES, 'UTF-8') ?></title>
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root, [data-theme="light"] {
            --bg-page: #f8fafc;
            --card-bg: #ffffff;
            --text-heading: #0f172a;
            --text-body: #475569;
            --text-muted: #94a3b8;
            --border-color: #e2e8f0;
            --brand-primary: #3b82f6;
            --brand-hover: #2563eb;
            --code-color: #64748b;
            --warning-bg: #fef3c7;
            --warning-border: #fde68a;
            --warning-text: #b45309;
            --danger-bg: #fee2e2;
            --danger-border: #fecaca;
            --danger-text: #b91c1c;
            --badge-bg: #f1f5f9;
            --badge-text: #475569;
            --badge-border: #cbd5e1;
        }
        [data-theme="dark"] {
            --bg-page: #0f172a;
            --card-bg: #1e293b;
            --text-heading: #f8fafc;
            --text-body: #cbd5e1;
            --text-muted: #64748b;
            --border-color: #334155;
            --brand-primary: #3b82f6;
            --brand-hover: #60a5fa;
            --code-color: #94a3b8;
            --warning-bg: rgba(245, 158, 11, 0.15);
            --warning-border: rgba(245, 158, 11, 0.3);
            --warning-text: #fbbf24;
            --danger-bg: rgba(239, 68, 68, 0.15);
            --danger-border: rgba(239, 68, 68, 0.3);
            --danger-text: #f87171;
            --badge-bg: #334155;
            --badge-text: #e2e8f0;
            --badge-border: #475569;
        }
        @media (prefers-color-scheme: dark) {
            [data-theme="auto"] {
                --bg-page: #0f172a;
                --card-bg: #1e293b;
                --text-heading: #f8fafc;
                --text-body: #cbd5e1;
                --text-muted: #64748b;
                --border-color: #334155;
                --brand-primary: #3b82f6;
                --brand-hover: #60a5fa;
                --code-color: #94a3b8;
                --warning-bg: rgba(245, 158, 11, 0.15);
                --warning-border: rgba(245, 158, 11, 0.3);
                --warning-text: #fbbf24;
                --danger-bg: rgba(239, 68, 68, 0.15);
                --danger-border: rgba(239, 68, 68, 0.3);
                --danger-text: #f87171;
                --badge-bg: #334155;
                --badge-text: #e2e8f0;
                --badge-border: #475569;
            }
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-body);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            -webkit-font-smoothing: antialiased;
        }
        .error-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            max-width: 32rem;
            width: 100%;
            padding: 2.75rem 2.25rem;
            text-align: center;
            position: relative;
        }
        .brand-header {
            margin-bottom: 1.75rem;
        }
        .brand-logo {
            max-height: 44px;
            width: auto;
            object-fit: contain;
        }
        .brand-fallback {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--brand-primary);
            letter-spacing: -0.025em;
        }
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--warning-bg);
            border: 1px solid var(--warning-border);
            color: var(--warning-text);
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
            font-size: 0.8125rem;
            font-weight: 700;
            margin-bottom: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .pulse-dot {
            width: 0.5rem;
            height: 0.5rem;
            background-color: #f59e0b;
            border-radius: 50%;
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse-ring {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.8); }
        }
        .status-code-large {
            font-size: 4.5rem;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -0.05em;
            color: var(--code-color);
            margin-bottom: 0.75rem;
            opacity: 0.85;
        }
        h1 {
            color: var(--text-heading);
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }
        .message {
            color: var(--text-body);
            font-size: 0.9375rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }
        .alert-danger {
            background-color: var(--danger-bg);
            border: 1px solid var(--danger-border);
            color: var(--danger-text);
            padding: 0.65rem 1rem;
            border-radius: 8px;
            font-size: 0.8125rem;
            margin-bottom: 1.25rem;
            text-align: left;
        }
        .clock-container {
            background: var(--bg-page);
            border: 1px solid var(--border-color);
            border-radius: 12px;
