<!DOCTYPE html>
<html lang="en" data-theme="<?= htmlspecialchars($theme ?? 'auto', ENT_QUOTES, 'UTF-8') ?>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title><?= htmlspecialchars($title ?? 'Error', ENT_QUOTES, 'UTF-8') ?> | <?= htmlspecialchars($appName ?? 'Application', ENT_QUOTES, 'UTF-8') ?></title>
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root, [data-theme="light"] {
            --bg-page: #f8fafc;
            --card-bg: #ffffff;
            --text-heading: #0f172a;
            --text-body: #475569;
            --text-muted: #94a3b8;
            --border-color: #e2e8f0;
            --brand-primary: #3b82f6;
            --brand-hover: #2563eb;
            --code-color: #64748b;
            --badge-bg: #f1f5f9;
            --badge-text: #475569;
            --badge-border: #cbd5e1;
        }
        [data-theme="dark"] {
            --bg-page: #0f172a;
            --card-bg: #1e293b;
            --text-heading: #f8fafc;
            --text-body: #cbd5e1;
            --text-muted: #64748b;
            --border-color: #334155;
            --brand-primary: #3b82f6;
            --brand-hover: #60a5fa;
            --code-color: #94a3b8;
            --badge-bg: #334155;
            --badge-text: #e2e8f0;
            --badge-border: #475569;
        }
        @media (prefers-color-scheme: dark) {
            [data-theme="auto"] {
                --bg-page: #0f172a;
                --card-bg: #1e293b;
                --text-heading: #f8fafc;
                --text-body: #cbd5e1;
                --text-muted: #64748b;
                --border-color: #334155;
                --brand-primary: #3b82f6;
                --brand-hover: #60a5fa;
                --code-color: #94a3b8;
                --badge-bg: #334155;
                --badge-text: #e2e8f0;
                --badge-border: #475569;
            }
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-body);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            -webkit-font-smoothing: antialiased;
        }
        .error-card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            max-width: 32rem;
            width: 100%;
            padding: 2.75rem 2.25rem;
            text-align: center;
            position: relative;
        }
        .brand-header {
            margin-bottom: 1.75rem;
        }
        .brand-logo {
            max-height: 44px;
            width: auto;
            object-fit: contain;
        }
        .brand-fallback {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--brand-primary);
            letter-spacing: -0.025em;
        }
        .status-badge {
            display: inline-flex;
            align-items: center;
            background: var(--badge-bg);
            border: 1px solid var(--badge-border);
            color: var(--badge-text);
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
            font-size: 0.8125rem;
            font-weight: 700;
            margin-bottom: 1.25rem;
            letter-spacing: 0.05em;
        }
        .status-code-large {
            font-size: 5rem;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -0.05em;
            color: var(--code-color);
            margin-bottom: 1rem;
            opacity: 0.85;
        }
        h1 {
            color: var(--text-heading);
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }
        .message {
            color: var(--text-body);
            font-size: 0.9375rem;
            line-height: 1.6;
            margin-bottom: 2rem;
        }
        .actions {
            display: flex;
            gap: 0.75rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        .btn {
            font-family: inherit;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            font-size: 0.875rem;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.15s ease-in-out;
            text-decoration: none;
            border: 1px solid transparent;
        }
        .btn-primary {
            background-color: var(--brand-primary);
            color: #ffffff;
        }
        .btn-primary:hover {
            background-color: var(--brand-hover);
        }
        .btn-outline {
            background-color: transparent;
            border-color: var(--border-color);
            color: var(--text-body);
        }
        .btn-outline:hover {
            background-color: var(--badge-bg);
            border-color: var(--badge-border);
        }
        .footer-note {
            margin-top: 2rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border-color);
            font-size: 0.75rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="brand-header">
            <img class="brand-logo" src="/logo.png" alt="Logo" onerror="this.style.display='none'; document.getElementById('brand-fallback').style.display='block';">
            <div id="brand-fallback" class="brand-fallback" style="display: none;">
                <?= htmlspecialchars($appName ?? 'Application', ENT_QUOTES, 'UTF-8') ?>
            </div>
        </div>

        <div class="status-code-large">
            <?= (int) ($code ?? 500) ?>
        </div>

        <div class="status-badge">
            <?= ((int) ($code ?? 500) === 503) ? 'SERVICE UNAVAILABLE' : ('HTTP ' . (int) ($code ?? 500) . ' ERROR') ?>
        </div>

        <h1><?= htmlspecialchars($title ?? 'An Error Occurred', ENT_QUOTES, 'UTF-8') ?></h1>

        <p class="message">
            <?= htmlspecialchars($message ?? 'An unexpected error has occurred. Please try again later.', ENT_QUOTES, 'UTF-8') ?>
        </p>

        <div class="actions">
            <?php if ((int) ($code ?? 500) === 503) { ?>
                <button type="button" class="btn btn-primary" onclick="window.location.reload()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <polyline points="1 20 1 14 7 14"></polyline>
                        <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                    </svg>
                    Refresh Now
                </button>
            <?php } else { ?>
                <a href="<?= htmlspecialchars($homeUrl ?? '/', ENT_QUOTES, 'UTF-8') ?>" class="btn btn-primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    Go to Homepage
                </a>
            <?php } ?>
            <button type="button" class="btn btn-outline" onclick="window.history.length > 1 ? window.history.back() : window.location.href='<?= htmlspecialchars($homeUrl ?? '/', ENT_QUOTES, 'UTF-8') ?>'">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Go Back
            </button>
        </div>

        <div class="footer-note">
            <?= htmlspecialchars($appName ?? 'Application', ENT_QUOTES, 'UTF-8') ?> &bull; &copy; <?= date('Y') ?>
        </div>
    </div>
</body>
</html>
